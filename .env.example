# Get this from @BotFather on Telegram after /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The public HTTPS URL where this app is hosted (Telegram requires HTTPS).
# While developing, this is your ngrok/tunnel URL. In production, your host's URL.
WEBAPP_URL=https://your-app-url.example.com

# Port the Express server listens on
PORT=3000

# Persistent storage — get these free at https://upstash.com (create a Redis
# database, then copy the REST URL and REST TOKEN from its dashboard). This
# is what keeps user balances safe across restarts/redeploys/free-tier
# sleep cycles — without it, a local file would get wiped on every restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your Monetag zone ID (get one free at https://monetag.com after adding your app).
MONETAG_ZONE_ID=11763151

# Your Adsgram blockId (from https://partner.adsgram.ai). If both this and
# MONETAG_ZONE_ID are set, Adsgram is used by default — set AD_PROVIDER
# below to force a specific one instead.
ADSGRAM_BLOCK_ID=47915

# Optional manual override: "monetag" or "adsgram". Leave blank to
# auto-pick based on which ID above is set.
AD_PROVIDER=

# How many demo points a user earns per completed ad view
REWARD_PER_AD=10

# Anti-abuse limits (mirrors what real ad networks require anyway)
MAX_ADS_PER_DAY=20
MIN_SECONDS_BETWEEN_ADS=30

# Password for the /admin.html dashboard. Pick your own — leave blank to
# disable the admin API entirely.
ADMIN_KEY=change-me
